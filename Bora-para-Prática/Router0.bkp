!
version 15.1
service timestamps log datetime msec
service timestamps debug datetime msec
service password-encryption
security passwords min-length 8
!
hostname rt-01
!
login block-for 120 attempts 2 within 60
!
!
enable secret 5 $1$mERr$Ob7Xf2qIzho.XMN7syJ.A0
!
!
!
!
!
!
no ip cef
no ipv6 cef
!
!
!
username cisco secret 5 $1$mERr$Ob7Xf2qIzho.XMN7syJ.A0
username jose privilege 15 secret 5 $1$mERr$1zgVlbfnjKA9Sd.UbVafp1
username mate
!
!
license udi pid CISCO1941/K9 sn FTX15243UW4-
!
!
!
!
!
!
!
!
!
!
!
ip ssh version 2
ip ssh authentication-retries 2
ip ssh time-out 60
no ip domain-lookup
ip domain-name pti.intra
!
!
spanning-tree mode pvst
!
!
!
!
!
!
interface GigabitEthernet0/0
 ip address 192.168.1.254 255.255.255.0
 duplex auto
 speed auto
!
interface GigabitEthernet0/1
 no ip address
 duplex auto
 speed auto
 shutdown
!
interface Vlan1
 no ip address
 shutdown
!
ip classless
!
ip flow-export version 9
!
!
ip access-list extended sl_def_acl
 deny tcp any any eq telnet
 deny tcp any any eq www
 deny tcp any any eq 22
 permit tcp any any eq 22
!
no cdp run
!
banner motd ^CAVISO: acesso autorizado somente a funcionarios^C
!
!
!
!
line con 0
 exec-timeout 5 30
 password 7 0822455D0A16254542595A
 logging synchronous
 login local
!
line aux 0
!
line vty 0 4
 exec-timeout 5 30
 logging synchronous
 login local
 transport input ssh
!
!
!
end
