!
version 15.0
service timestamps log datetime msec
no service timestamps debug datetime msec
service password-encryption
!
hostname sw-01
!
enable secret 5 $1$mERr$Ob7Xf2qIzho.XMN7syJ.A0
!
!
!
ip ssh version 2
ip ssh authentication-retries 2
ip ssh time-out 60
ip domain-name pti.intra
ip host google 8.8.8.8 
ip host switch1 192.168.1.250 
ip name-server 192.168.1.1
!
username cisco secret 5 $1$mERr$Ob7Xf2qIzho.XMN7syJ.A0
username jose secret 5 $1$mERr$1zgVlbfnjKA9Sd.UbVafp1
username tome privilege 1 password 7 083543430C395747405E
!
!
!
spanning-tree mode pvst
spanning-tree extend system-id
!
interface FastEthernet0/1
!
interface FastEthernet0/2
!
interface FastEthernet0/3
!
interface FastEthernet0/4
!
interface FastEthernet0/5
!
interface FastEthernet0/6
!
interface FastEthernet0/7
!
interface FastEthernet0/8
!
interface FastEthernet0/9
